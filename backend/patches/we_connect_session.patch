+# IDK qmauth constants (from evcc idkproxy implementation)
+_QM_SECRET = bytes.fromhex("e47866378ef0658ce75d71007a809f34616b9635e2ec228245784c1f63e88d06")
+_QM_CLIENT_ID = "c95f4fd2"
 
+
+def _qmauth_now() -> str:
+    """Generate the x-qmauth header value (time-based HMAC-SHA256)."""
+    ts = int(time.time()) // 100
+    mac = hmac.new(_QM_SECRET, str(ts).encode(), hashlib.sha256).hexdigest()
+    return f"v1:{_QM_CLIENT_ID}:{mac}"
+
+
+def _pkce_pair():
+    """Generate a PKCE code_verifier and code_challenge (S256, RFC 7636)."""
+    code_verifier = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode('ascii')
+    digest = hashlib.sha256(code_verifier.encode('ascii')).digest()
+    code_challenge = base64.urlsafe_b64encode(digest).rstrip(b'=').decode('ascii')
+    return code_verifier, code_challenge
+
